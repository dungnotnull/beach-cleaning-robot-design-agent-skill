{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence-output.schema.json",
  "title": "Evidence Output Schema",
  "description": "Output schema for sub-evidence-collector skill",
  "type": "object",
  "properties": {
    "current_data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Source name or URL"
          },
          "value": {},
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp"
          },
          "tier": {
            "type": "string",
            "enum": ["1", "2", "3", "4"],
            "description": "Evidence tier level"
          }
        },
        "required": ["source", "value", "tier"]
      }
    },
    "authoritative_docs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string"},
          "type": {"type": "string"},
          "tier": {"type": "string", "enum": ["1", "2", "3", "4"]}
        },
        "required": ["title", "url", "tier"]
      }
    },
    "recent_news": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "headline": {"type": "string"},
          "source": {"type": "string"},
          "url": {"type": "string"},
          "date": {"type": "string"}
        },
        "required": ["headline", "source"]
      }
    },
    "reference_benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {"type": "string"},
          "value": {},
          "unit": {"type": "string"},
          "source": {"type": "string"}
        },
        "required": ["metric", "value"]
      }
    }
  },
  "required": ["current_data", "authoritative_docs"]
}
